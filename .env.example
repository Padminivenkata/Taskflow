# ---------------------------------------------------------------------------
# Taskflow environment template
#
# Copy this file to `.env` (or `.env.local`) and fill in the real values from
# your Supabase project:  Supabase Dashboard > Project Settings > API
#
# ONLY the values below may ever be present in a frontend environment.
# NEVER place the Supabase `service_role` key here or in GitHub.
# ---------------------------------------------------------------------------

# Public Supabase project URL. Safe to expose (it is designed to be public).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon / "publishable" key. Safe to expose; access is governed by RLS.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Comma separated extra origins allowed to call Supabase Realtime
# (comma separated, or leave blank to allow the dashboard default).
VITE_ALLOWED_ORIGINS=http://localhost:5173
